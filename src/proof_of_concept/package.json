{
  "name": "usflights-hexagonal-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of Concept: Hexagonal Architecture (Ports & Adapters) with Node 26 + TypeScript",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "adapters/driving/*",
    "adapters/driven/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "start:memory": "PERSISTENCE=memory node --env-file-if-exists=.env apps/api/src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env apps/api/src/main.ts",
    "cli": "node --env-file-if-exists=.env apps/cli/src/main.ts",
    "cli:memory": "PERSISTENCE=memory node --env-file-if-exists=.env apps/cli/src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=.env --test '{packages,adapters,apps}/**/src/**/*.unit.test.ts' '{packages,adapters,apps}/**/src/**/*.int.test.ts'",
    "test:unit": "node --test '{packages,adapters,apps}/**/src/**/*.unit.test.ts'",
    "test:integration": "node --env-file-if-exists=.env --test '{packages,adapters,apps}/**/src/**/*.int.test.ts'",
    "test:e2e": "node --env-file-if-exists=.env --test '{packages,adapters,apps}/**/src/**/*.e2e.test.ts'",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "node --env-file-if-exists=.env --test --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='**/testing/**' --test-coverage-exclude='**/node_modules/**' '{packages,adapters,apps}/**/src/**/*.unit.test.ts' '{packages,adapters,apps}/**/src/**/*.int.test.ts'",
    "test:watch": "node --test --watch '{packages,adapters,apps}/**/src/**/*.unit.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.15.0",
    "typescript": "^7.0.2"
  }
}

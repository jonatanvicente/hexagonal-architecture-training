# Copy to .env and fill in the secrets. .env is git-ignored.

# --- Driven adapter selection: postgres | memory
PERSISTENCE=postgres

# --- PostgreSQL (driven adapter: adapters/driven/postgres)
PGHOST=localhost
PGPORT=5432
PGDATABASE=usflights
PGUSER=postgres
PGPASSWORD=

# --- HTTP driving adapter
# Loopback by default: the API has NO authentication – do not expose it on 0.0.0.0.
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# --- Domain policy: FAA considers a flight delayed when it arrives >= 15 minutes late
DELAY_THRESHOLD_MIN=15

# --- Simulated Redis cache TTL (seconds)
CACHE_TTL_SECONDS=60

# --- Simulated notification gateway recipients (contains '@' -> EMAIL, otherwise SMS)
OPS_RECIPIENTS=ops@usflights.example,+1-555-0100

# --- trace | debug | info | warn | error
LOG_LEVEL=info
